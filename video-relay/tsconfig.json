{
  "extends": "../tsconfig.base.json",
  // `node` is needed for route/dev-helper unit tests and the dev CLI
  // scripts; the Worker itself is compiled against Workers types.
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "node", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["src"]
}
