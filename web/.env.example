# Copy to .env.local (ignored by git, see .gitignore: "*.local") and
# point to a real relay. Without this file the dashboard starts with only
# MockTransport: the "WebSocket" option is disabled in the selector,
# it does not fail silently.

# WSS base of the relay. Local (wrangler dev): ws://localhost:8787
# Deployed on Cloudflare: wss://rovelink-relay.<your-subdomain>.workers.dev
VITE_RELAY_URL=ws://localhost:8787

# WSS base of the DEDICATED video relay (Problem 7B-7D) — a separate
# deployment from VITE_RELAY_URL above, never the same Worker. Local
# (wrangler dev, video-relay/): ws://localhost:8788 (pick a port that
# doesn't collide with the control relay's own `wrangler dev`).
# Deployed: wss://rovelink-video-relay.<your-subdomain>.workers.dev
# Optional: leaving this unset disables the video panel entirely rather
# than failing — see video/ticket-source.ts / control-view.ts.
VITE_VIDEO_RELAY_URL=ws://localhost:8788

# Must match ROBOT_ID in firmware/config.h.
VITE_ROBOT_ID=robot-01
