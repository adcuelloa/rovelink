# Copy to .env.local (ignored by git, see .gitignore: "*.local") and
# point to a real relay. Without this file the dashboard starts with only
# MockTransport: the "WebSocket" option is disabled in the selector,
# it does not fail silently.

# WSS base of the relay. Local (wrangler dev): ws://localhost:8787
# Deployed on Cloudflare: wss://rovelink-relay.<your-subdomain>.workers.dev
VITE_RELAY_URL=ws://localhost:8787

# Must match ROBOT_ID in firmware/config.h.
VITE_ROBOT_ID=robot-01
