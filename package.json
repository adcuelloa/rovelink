{
  "name": "rovelink",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rovelink/web dev",
    "dev:relay": "pnpm --filter @rovelink/relay dev",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm fmt:check && pnpm lint && pnpm -r typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.0.0"
}
