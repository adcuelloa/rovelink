{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rovelink-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // One room per robot: the Durable Object id comes from the robot name.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RobotRoom" }],
  },
  // SQLite classes: what the free plan supports for Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RobotRoom"] }],
  // Set with `wrangler secret put DEVICE_SECRET` / `CONTROLLER_SECRET` — never
  // here. Declaring the names makes `wrangler deploy` fail loudly if either is
  // missing, instead of silently deploying a relay that fails every auth check.
  "secrets": { "required": ["DEVICE_SECRET", "CONTROLLER_SECRET"] },
}
