{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rovelink-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  // One room per robot: the Durable Object id comes from the robot name.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RobotRoom" }],
  },
  // SQLite classes: what the free plan supports for Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RobotRoom"] }],
  // Set with `wrangler secret put DEVICE_SECRET` / `CONTROLLER_SECRET` /
  // `VIDEO_TICKET_SECRET` — never here. VIDEO_TICKET_SECRET must match the
  // video relay's own VIDEO_TICKET_SECRET exactly (see
  // video-relay/wrangler.jsonc) — it is how the two Workers agree a ticket
  // minted here is genuine. Declaring the names makes `wrangler deploy`
  // fail loudly if any is missing, instead of silently deploying a relay
  // that fails every auth check.
  "secrets": { "required": ["DEVICE_SECRET", "CONTROLLER_SECRET", "VIDEO_TICKET_SECRET"] },
}
