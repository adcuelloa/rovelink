---
/**
 * Home-page learning-path card: type + title + short purpose + destination.
 * Plain Astro/CSS, no hydration — used only on the splash page card grid.
 * Styles in learn.css.
 */
interface Props {
  readonly type: string;
  readonly title: string;
  readonly href: string;
  readonly cta: string;
}

const { type, title, href, cta } = Astro.props;
---

<a class="rl-card" href={href}>
  <span class="rl-card__type">{type}</span>
  <h3 class="rl-card__title">{title}</h3>
  <p class="rl-card__body"><slot /></p>
  <span class="rl-card__cta">{cta}</span>
</a>
